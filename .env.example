# Takes priority over PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE when set.
DATABASE_URL=postgres://titikapi:titikapi@localhost:5442/titikapi
TEST_DATABASE_URL=postgres://titikapi:titikapi@localhost:5442/titikapi_test
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./storage/uploads
WEB_DIR=../web/dist
NODE_ENV=development
# Minutes between NASA FIRMS pulls; 0 turns the scheduler off (tests, offline work).
INGEST_INTERVAL_MINUTES=30
# Behind a reverse proxy: which proxies may report the visitor's address (addresses or ranges; "true" = a proxy on a private network).
# TRUST_PROXY=true
# Docker: empty seeds in development only; true/false explicitly overrides it.
SEED_DEMO=
